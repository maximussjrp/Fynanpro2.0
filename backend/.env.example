# ==============================================
# UTOP - Sistema Financeiro Pessoal
# Configuração de Ambiente
# ==============================================
# IMPORTANTE: Este projeto usa APENAS o banco de dados do servidor de produção
# Não existe banco de dados local!

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=4000
APP_URL=https://api.utopsistema.com.br
FRONTEND_URL=https://utopsistema.com.br

# ==============================================
# DATABASE (PostgreSQL - SERVIDOR DE PRODUÇÃO)
# ==============================================
# Para desenvolvimento local, use SSH tunnel:
# ssh -L 5433:localhost:5432 root@91.99.16.145
# Depois use: DATABASE_URL="postgresql://utop_user:SENHA@localhost:5433/utop?schema=public"
#
# Em produção (Docker no servidor):
# DATABASE_URL=postgresql://utop_user:SENHA@utop-postgres:5432/utop?schema=public

DATABASE_URL="postgresql://utop_user:SUA_SENHA_AQUI@utop-postgres:5432/utop?schema=public"

# ==============================================
# REDIS
# ==============================================
# Em produção (Docker):
REDIS_URL=redis://utop-redis:6379
# Local com SSH tunnel: redis://localhost:6380

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRATION=2h
JWT_REFRESH_EXPIRATION=30d

# ==============================================
# EMAIL (Resend)
# ==============================================
RESEND_API_KEY=
EMAIL_FROM=UTOP <noreply@utopsistema.com.br>

# ==============================================
# STRIPE (Pagamentos)
# ==============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_YEARLY=

# ==============================================
# SUPER MASTER
# ==============================================
SUPER_MASTER_EMAIL=supermaster@utopsistema.com.br
SUPER_MASTER_PASSWORD=

# ==============================================
# SEED (apenas para `npm run prisma:seed`)
# ==============================================
# Senha do usuário master criado pelo seed. Obrigatória para rodar o seed.
SEED_MASTER_PASSWORD=
