/// Append-only. Sem update/delete em service layer.
model PartnerAuditLog {
  id          String             @id @default(uuid())
  action      PartnerAuditAction
  actorUserId String
  subjectType String             @db.VarChar(40)
  subjectId   String
  payload     Json
