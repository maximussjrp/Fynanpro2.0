  @@index([sponsorConsultantId])
  @@map("partner_sponsorship_edges")
}

model Course {
  id         String   @id @default(uuid())
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]

  @@map("partner_courses")
}

/// status='certificada' duplica a existência de Certificate por design
/// (permite checar elegibilidade sem JOIN). Certificate é a evidência auditável.
model Enrollment {
  id              String           @id @default(uuid())
  consultantId    String
  courseId        String
  status          EnrollmentStatus @default(nao_iniciada)
  progressPct     Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  paymentRecordId String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  consultant  ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  certificate Certificate?

  @@unique([consultantId, courseId])
  @@index([status])
  @@map("partner_enrollments")
}

model Certificate {
  id           String   @id @default(uuid())
  enrollmentId String   @unique
  code         String   @unique
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@map("partner_certificates")
}

/// status NUNCA inclui 'prevista'. Comissão prevista = view calculada.
/// Vínculo comissão↔batch é exclusivo via CommissionBatchItem.
model Commission {
  id                      String                 @id @default(uuid())
  paymentRecordId         String
  beneficiaryConsultantId String
  level                   Int
  eventType               CommissionEventType
  percentBps              Int
  amountCents             Int
  status                  CommissionStatus       @default(em_hold)
  blockReason             CommissionBlockReason?
  holdUntil               DateTime
  approvedAt              DateTime?
  paidAt                  DateTime?
  reversedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  beneficiary ConsultantProfile     @relation(fields: [beneficiaryConsultantId], references: [id], onDelete: Restrict)
  batchItems  CommissionBatchItem[]

  @@unique([paymentRecordId, beneficiaryConsultantId, level])
  @@index([status, holdUntil])
  @@index([beneficiaryConsultantId, status])
  @@index([paymentRecordId])
  @@map("partner_commissions")
}

model CommissionBatch {
  id                  String                @id @default(uuid())
  referenceMonth      String                @unique
  status              CommissionBatchStatus @default(aberto)
  totalCents          Int                   @default(0)
  closedAt            DateTime?
  paidAt              DateTime?
  closedByAdminUserId String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  items   CommissionBatchItem[]
  payouts Payout[]

  @@index([status])
  @@map("partner_commission_batches")
}

model CommissionBatchItem {
  id           String   @id @default(uuid())
  batchId      String
  commissionId String   @unique
  payoutId     String?
  createdAt    DateTime @default(now())

  batch      CommissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  commission Commission      @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  payout     Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([payoutId])
  @@map("partner_commission_batch_items")
}

/// SNAPSHOT IMUTÁVEL: pixKey/pixKeyType gravados no fechamento do batch.
/// Service NUNCA relê do perfil do consultor depois disso.
model Payout {
  id              String       @id @default(uuid())
  batchId         String
  consultantId    String
  amountCents     Int
  pixKey          String       @db.VarChar(140)
  pixKeyType      String       @db.VarChar(20)
  status          PayoutStatus @default(pendente)
  asaasTransferId String?
  paidAt          DateTime?
  failureReason   String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  batch         CommissionBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  consultant    ConsultantProfile       @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  items         CommissionBatchItem[]
  walletEntries ConsultantWalletEntry[]

  @@unique([batchId, consultantId])
  @@index([status])
  @@index([consultantId])
  @@map("partner_payouts")
}

/// Saldo do consultor = SUM(deltaCents). Saldo negativo trava saques (§0.3).
model ConsultantWalletEntry {
  id                   String            @id @default(uuid())
  consultantId         String
  deltaCents           Int
  reason               WalletEntryReason
  refType              String            @db.VarChar(40)
  refId                String?
  payoutId             String?
  description          String?           @db.VarChar(500)
  createdByAdminUserId String?
  createdAt            DateTime          @default(now())

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  payout     Payout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([consultantId, createdAt])
  @@index([reason])
  @@map("partner_wallet_entries")
}

model PartnerKyc {
  id                    String    @id @default(uuid())
  consultantId          String    @unique
  status                KycStatus @default(pendente)
  reviewedAt            DateTime?
  reviewedByAdminUserId String?
  rejectReason          String?   @db.VarChar(500)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  consultant ConsultantProfile    @relation(fields: [consultantId], references: [id], onDelete: Restrict)
