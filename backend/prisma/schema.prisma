generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(uuid())
  email                    String         @unique
  passwordHash             String
  fullName                 String
  role                     String         @default("owner")
  isActive                 Boolean        @default(true)
  isEmailVerified          Boolean        @default(false)
  lastLoginAt              DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  deletedAt                DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  ownedTenants             Tenant[]       @relation("TenantOwner")
  tenantUsers              TenantUser[]
  transactions             Transaction[]
}

model Tenant {
  id                     String                    @id @default(uuid())
  ownerId                String
  name                   String
  slug                   String                    @unique
  subscriptionPlan       String                    @default("trial")
  subscriptionStatus     String                    @default("active")
  trialEndsAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  deletedAt              DateTime?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  auditLogs              AuditLog[]
  bankAccounts           BankAccount[]
  budgets                Budget[]
  categories             Category[]
  imports                Import[]
  installments           Installment[]
  installmentPurchases   InstallmentPurchase[]
  notifications          Notification[]
  paymentMethods         PaymentMethod[]
  recurringBills         RecurringBill[]
  recurringOccurrences   RecurringBillOccurrence[]
  savedFilters           SavedFilter[]
  owner                  User                      @relation("TenantOwner", fields: [ownerId], references: [id])
  tenantUsers            TenantUser[]
  transactions           Transaction[]
  triggerCategories      TriggerCategory[]
  userProfiles           UserProfile[]

  @@index([ownerId])
  @@index([subscriptionPlan])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model TenantUser {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  role        String    @default("member")
  permissions String?
  invitedBy   String?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

model Category {
  id                   String                @id @default(uuid())
  tenantId             String
  parentId             String?
  name                 String
  type                 String                @default("expense")
  level                Int                   @default(1)
  icon                 String?
  color                String?
  isActive             Boolean               @default(true)
  order                Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  budgets              Budget[]
  parent               Category?             @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children             Category[]            @relation("CategoryChildren")
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semantics            CategorySemantics?
  installmentPurchases InstallmentPurchase[]
  recurringBills       RecurringBill[]
  transactions         Transaction[]
  triggerCategories    TriggerCategory[]

  @@index([tenantId, parentId])
  @@index([type])
  @@index([tenantId, type, isActive])
  @@index([tenantId, isActive])
}

model CategorySemantics {
  id               String    @id @default(uuid())
  categoryId       String    @unique
  tenantId         String
  generatedWeight  Decimal   @default(0) @db.Decimal(5, 4)
  survivalWeight   Decimal   @default(0) @db.Decimal(5, 4)
  choiceWeight     Decimal   @default(0) @db.Decimal(5, 4)
  futureWeight     Decimal   @default(0) @db.Decimal(5, 4)
  lossWeight       Decimal   @default(0) @db.Decimal(5, 4)
  isFixed          Boolean   @default(false)
  isEssential      Boolean   @default(false)
  isInvestment     Boolean   @default(false)
  validationStatus String    @default("inferred")
  validatedAt      DateTime?
  validatedBy      String?
  justification    String?
  userOverride     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([validationStatus])
  @@index([tenantId, validationStatus])
}

model BankAccount {
  id             String             @id @default(uuid())
  tenantId       String
  name           String
  type           String
  institution    String?
  currentBalance Decimal            @default(0) @db.Decimal(15, 2)
  initialBalance Decimal            @default(0) @db.Decimal(15, 2)
  isActive       Boolean            @default(true)
  color          String?
  icon           String?
  order          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owners         BankAccountOwner[]
  installments   Installment[]
  paymentMethods PaymentMethod[]
  recurringBills RecurringBill[]
  transactions   Transaction[]

  @@index([tenantId, isActive])
  @@index([tenantId, type])
}

model PaymentMethod {
  id             String          @id @default(uuid())
  tenantId       String
  bankAccountId  String?
  name           String
  type           String
  lastFourDigits String?
  isActive       Boolean         @default(true)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  cardNetwork    String?
  expirationDate DateTime?
  installments   Installment[]
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringBills RecurringBill[]
  transactions   Transaction[]

  @@index([tenantId, isActive])
  @@index([tenantId, type, isActive])
}

model Transaction {
  id                    String         @id @default(uuid())
  tenantId              String
  userId                String
  type                  String
  categoryId            String?
  bankAccountId         String?
  paymentMethodId       String?
  destinationAccountId  String?
  amount                Decimal        @db.Decimal(15, 2)
  description           String?
  transactionDate       DateTime
  status                String         @default("completed")
  isRecurring           Boolean        @default(false)
  recurringBillId       String?
  tags                  String?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  daysEarlyLate         Int?
  dueDate               DateTime?
  installmentId         String?
  isFixed               Boolean        @default(true)
  isPaidEarly           Boolean?
  isPaidLate            Boolean?
  paidDate              DateTime?
  transactionType       String         @default("single")
  originalAmount        Decimal?       @db.Decimal(15, 2)
  parentId              String?
  frequency             String?
  frequencyInterval     Int?
  totalOccurrences      Int?
  currentOccurrence     Int?
  startDate             DateTime?
  endDate               DateTime?
  nextDueDate           DateTime?
  alertDaysBefore       Int?
  autoGenerateNext      Boolean?
  totalInstallments     Int?
  installmentNumber     Int?
  hasDownPayment        Boolean?
  downPaymentAmount     Decimal?       @db.Decimal(15, 2)
  occurrenceNumber      Int?
  importBatchId         String?
  importSource          String?
  externalFitId         String?
  rawDescription        String?
  normalizedDescription String?
  isTransfer            Boolean        @default(false)
  transferGroupId       String?
  linkedTransactionId   String?
  transactionKind       String         @default("bank")
  excludedFromEnergy    Boolean        @default(false)
  excludedReason        String?
  needsReview           Boolean        @default(false)
  reviewSuggestion      String?
  reviewedAt            DateTime?
  reviewedBy            String?
  userProfileId         String?
  energyChoice          Decimal?       @db.Decimal(5, 4)
  energyFuture          Decimal?       @db.Decimal(5, 4)
  energyJustification   String?
  energyLoss            Decimal?       @db.Decimal(5, 4)
  energySource          String?
  energySurvival        Decimal?       @db.Decimal(5, 4)
  bankAccount           BankAccount?   @relation(fields: [bankAccountId], references: [id])
  category              Category?      @relation(fields: [categoryId], references: [id])
  parent                Transaction?   @relation("TransactionHierarchy", fields: [parentId], references: [id], onUpdate: NoAction)
  children              Transaction[]  @relation("TransactionHierarchy")
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id])
  userProfile           UserProfile?   @relation("TransactionProfile", fields: [userProfileId], references: [id])

  @@index([tenantId, transactionDate])
  @@index([categoryId])
  @@index([type, status])
  @@index([userId])
  @@index([userProfileId])
  @@index([tenantId, type, transactionDate])
  @@index([tenantId, status, transactionDate])
  @@index([tenantId, categoryId, transactionDate])
  @@index([bankAccountId, transactionDate])
  @@index([tenantId, dueDate, status])
  @@index([tenantId, isFixed, status])
  @@index([recurringBillId])
  @@index([parentId])
  @@index([transactionType])
  @@index([tenantId, transactionType, status])
  @@index([tenantId, externalFitId])
  @@index([tenantId, importBatchId])
  @@index([tenantId, isTransfer])
  @@index([tenantId, excludedFromEnergy])
  @@index([tenantId, needsReview])
  @@index([transferGroupId])
}

model RecurringBill {
  id               String                    @id @default(uuid())
  tenantId         String
  categoryId       String?
  bankAccountId    String?
  paymentMethodId  String?
  name             String
  amount           Decimal?                  @db.Decimal(15, 2)
  isVariableAmount Boolean                   @default(false)
  frequency        String                    @default("monthly")
  dueDay           Int
  firstDueDate     DateTime?
  lastDueDate      DateTime?
  alertDaysBefore  Int                       @default(3)
  alertOnDueDay    Boolean                   @default(true)
  alertIfOverdue   Boolean                   @default(true)
  autoGenerate     Boolean                   @default(true)
  status           String                    @default("active")
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  type             String                    @default("expense")
  isFixed          Boolean                   @default(true)
  monthsAhead      Int                       @default(3)
  isTemplate       Boolean                   @default(false)
  bankAccount      BankAccount?              @relation(fields: [bankAccountId], references: [id])
  category         Category?                 @relation(fields: [categoryId], references: [id])
  paymentMethod    PaymentMethod?            @relation(fields: [paymentMethodId], references: [id])
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences      RecurringBillOccurrence[]

  @@index([tenantId, status])
  @@index([dueDay])
  @@index([tenantId, status, dueDay])
  @@index([tenantId, type, status])
  @@index([tenantId, isFixed, status])
}

model RecurringBillOccurrence {
  id              String        @id @default(uuid())
  tenantId        String
  recurringBillId String
  dueDate         DateTime
  amount          Decimal       @db.Decimal(15, 2)
  paidDate        DateTime?
  paidAmount      Decimal?      @db.Decimal(15, 2)
  status          String        @default("pending")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate, status])
  @@index([recurringBillId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, deletedAt])
}

model InstallmentPurchase {
  id                   String        @id @default(uuid())
  tenantId             String
  categoryId           String?
  name                 String
  description          String?
  totalAmount          Decimal       @db.Decimal(15, 2)
  numberOfInstallments Int
  installmentAmount    Decimal       @db.Decimal(15, 2)
  firstDueDate         DateTime
  remainingBalance     Decimal       @db.Decimal(15, 2)
  paidInstallments     Int           @default(0)
  status               String        @default("active")
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  isFixed              Boolean       @default(false)
  installments         Installment[]
  category             Category?     @relation(fields: [categoryId], references: [id])
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, status, firstDueDate])
  @@index([tenantId, isFixed, status])
}

model Installment {
  id                    String              @id @default(uuid())
  tenantId              String
  installmentPurchaseId String
  bankAccountId         String?
  paymentMethodId       String?
  installmentNumber     Int
  dueDate               DateTime
  amount                Decimal             @db.Decimal(15, 2)
  paidDate              DateTime?
  paidAmount            Decimal?            @db.Decimal(15, 2)
  status                String              @default("pending")
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bankAccount           BankAccount?        @relation(fields: [bankAccountId], references: [id])
  installmentPurchase   InstallmentPurchase @relation(fields: [installmentPurchaseId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate, status])
  @@index([installmentPurchaseId])
  @@index([tenantId, status, dueDate])
}

model Budget {
  id         String   @id @default(uuid())
  tenantId   String
  categoryId String
  alertAt80  Boolean  @default(true)
  alertAt100 Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  alertAt90  Boolean  @default(true)
  amount     Decimal  @db.Decimal(15, 2)
  endDate    DateTime
  isActive   Boolean  @default(true)
  name       String
  period     String   @default("monthly")
  startDate  DateTime
  category   Category @relation(fields: [categoryId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, categoryId, isActive])
  @@index([startDate, endDate])
  @@index([tenantId, isActive, startDate])
  @@index([tenantId, period, isActive])
}

model TriggerCategory {
  id              String   @id @default(uuid())
  tenantId        String
  categoryId      String
  monthlyLimit    Decimal? @db.Decimal(15, 2)
  alertMessage    String?
  trackingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        Category @relation(fields: [categoryId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId])
}

model Notification {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  type          String
  title         String
  message       String
  isRead        Boolean  @default(false)
  priority      String   @default("normal")
  relatedId     String?
  relatedType   String?
  createdAt     DateTime @default(now())
  actionUrl     String?
  transactionId String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([createdAt])
  @@index([tenantId, isRead, createdAt])
  @@index([type, isRead])
}

model Import {
  id                      String    @id @default(uuid())
  tenantId                String
  userId                  String?
  fileName                String
  fileType                String
  status                  String    @default("pending")
  totalRows               Int?
  processedRows           Int       @default(0)
  errorRows               Int       @default(0)
  errorLog                String?
  createdAt               DateTime  @default(now())
  completedAt             DateTime?
  bankAccountId           String?
  createdCount            Int       @default(0)
  dedupedCount            Int       @default(0)
  transferPairs           Int       @default(0)
  invoicePayments         Int       @default(0)
  needsReviewCount        Int       @default(0)
  excludedFromEnergyCount Int       @default(0)
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model SavedFilter {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  name       String
  filterType String
  filterData String
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, filterType])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String
  action       String
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  changes      String?
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, action])
  @@index([createdAt])
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, isRevoked, expiresAt])
}

model AdminLog {
  id            String   @id @default(uuid())
  adminId       String
  action        String
  targetType    String
  targetId      String
  description   String
  previousValue String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model SystemAnnouncement {
  id          String    @id @default(uuid())
  title       String
  type        String    @default("info")
  targetPlans String?
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  content     String
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
}

model ChatSession {
  id              String        @id @default(uuid())
  tenantId        String
  userId          String
  state           String        @default("idle")
  context         String?
  learnedPatterns String?
  lastActiveAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([lastActiveAt])
}

model ChatMessage {
  id           String      @id @default(uuid())
  sessionId    String
  role         String
  content      String
  options      String?
  quickReplies String?
  metadata     String?
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId])
}

model UserProfile {
  id                String             @id @default(uuid())
  tenantId          String
  name              String
  document          String?
  documentType      String             @default("PF")
  isDefault         Boolean            @default(false)
  avatar            String?
  color             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  bankAccountOwners BankAccountOwner[]
  transactions      Transaction[]      @relation("TransactionProfile")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, document])
  @@index([tenantId, isDefault])
}

model BankAccountOwner {
  id               String      @id @default(uuid())
  bankAccountId    String
  userProfileId    String
  ownershipPercent Decimal     @default(100) @db.Decimal(5, 2)
  isPrimaryOwner   Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  userProfile      UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, userProfileId])
  @@index([bankAccountId])
  @@index([userProfileId])
}
