  @@index([consultantId])
  @@index([active])
  @@map("partner_referral_links")
}

/// Primeira-atribuição-vence. targetUserId SEMPRE referencia User.id
/// (nunca ConsultantProfile.id ou ClientProfile.id). Validado em service.
/// reattributionEligibleAt = janela de exclusividade (não expiração imediata).
model ReferralAttribution {
  id                      String                @id @default(uuid())
  attributionType         AttributionType
  targetType              AttributionTargetType
  targetUserId            String
  consultantId            String
  linkId                  String?
  ip                      String?
  userAgent               String?               @db.VarChar(512)
  attributedAt            DateTime              @default(now())
  reattributionEligibleAt DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  link       ReferralLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([targetType, targetUserId])
  @@index([consultantId])
  @@index([attributedAt])
  @@map("partner_referral_attributions")
}

/// Verdade primária: consultantId + sponsorConsultantId.
/// level (N1/N2/N3) é DERIVADO em runtime — nunca persistido.
model SponsorshipEdge {
