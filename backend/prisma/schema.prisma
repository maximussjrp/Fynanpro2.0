/// POLÍTICA: banimento é TERMINAL e ÚNICO por consultor (forçado por @unique).
/// Reversão = ato administrativo registrado em PartnerAuditLog + DELETE.
/// Não existe "ban inativo".
model ConsultantBan {
  id                  String    @id @default(uuid())
  consultantId        String    @unique
  reason              BanReason
  notes               String    @db.VarChar(1000)
  bannedByAdminUserId String
  bannedAt            DateTime  @default(now())

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Restrict)

  @@map("partner_consultant_bans")
}
